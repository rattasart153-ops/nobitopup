<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>Nobi Gaming Admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Mitr:wght@400;500;600&family=Noto+Sans+Thai:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#14123A; --ink-2:#1D1A52; --ink-3:#28246B; --line:#3A3680; --deep:#0F0D2E;
  --gold:#FFC53D; --coral:#FF6B5B; --mint:#4FE3B8; --paper:#FFF3D1; --paper-ink:#2A2147;
  --text:#F3F1FF; --muted:#B3AFE0;
  --display:"Mitr","Noto Sans Thai",system-ui,sans-serif;
  --body:"Noto Sans Thai",system-ui,-apple-system,"Segoe UI",sans-serif;
}
*{box-sizing:border-box}
body{margin:0;background:var(--ink);color:var(--text);font-family:var(--body);font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px;border-radius:6px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
[hidden]{display:none!important}

/* login */
.login{min-height:100vh;display:grid;place-items:center;padding:20px}
.login-card{width:min(420px,100%);background:var(--ink-2);border:1px solid var(--line);border-radius:22px;padding:30px 28px}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--display);font-weight:600;font-size:1.3rem}
.coin{width:30px;height:30px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#FFE08A,var(--gold) 55%,#E09A00);box-shadow:inset 0 0 0 3px #E8A500,inset 0 0 0 5px rgba(255,255,255,.35);display:grid;place-items:center;color:#8A5A00;font-family:var(--display);font-size:.9rem}
.login h1{font-family:var(--display);font-weight:500;font-size:1.7rem;margin:18px 0 4px}
.login p{color:var(--muted);margin:0 0 18px}
label.f{display:block;font-size:.9rem;color:var(--muted);margin-bottom:12px}
.input,select.input,textarea.input{display:block;width:100%;margin-top:6px;background:var(--ink);border:1.5px solid var(--line);border-radius:12px;padding:10px 14px;color:var(--text)}
.input:focus{outline:none;border-color:var(--gold)}
.input[aria-invalid="true"]{border-color:var(--coral)}
.err{color:#FF9A8F;font-size:.88rem;min-height:1.3em;margin-top:2px}
.hint{color:var(--muted);font-size:.84rem;margin-top:2px}
.btn{border:0;border-radius:12px;padding:9px 18px;cursor:pointer;font-weight:600;background:var(--gold);color:#3A2800}
.btn.coral{background:var(--coral);color:#fff}
.btn.line{background:transparent;color:var(--text);border:1px solid var(--line);font-weight:500}
.btn.line:hover{border-color:var(--gold)}
.btn.sm{padding:3px 12px;font-size:.86rem;border-radius:999px}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.block{width:100%;padding:12px;font-family:var(--display);font-size:1.05rem;font-weight:500}
